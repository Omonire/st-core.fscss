@import((*) from st-core@v2)
@import((*) from icon-mask)

/* ── Design tokens ── */
@st-root()

:root {
  --st-bg: #0a0a0f;
  --st-surface: #12121a;
  --st-card: #1a1a24;
  --st-accent: #5eead4;
  --st-accent-2: #a78bfa;
  --st-green: #34d399;
  --st-red: #f87171;
  --st-text: #f1f5f9;
  --st-muted: #94a3b8;
  --st-border: rgba(148, 163, 184, 0.12);
  --st-radius-xl: 28px;
  --st-radius-lg: 18px;
  --st-radius-md: 14px;
  --st-pad: 20px;

  @icon-color($st-muted)
  @icon-size(18px)
}

@icon-pack()
@st-container(body)

body {
  ff: 'Inter', system-ui, sans-serif;
  bg: #e8eaf0;
  min-h: 100vh;
  center: both;          /* grid + place-items: center */
  gap: 40px;
  py: 40px;
  px: 20px;
  fwrap: wrap;
}

/* ── Phone shells ── */
@st-phone(.phone)
.phone {
  w: 340px;
  bg: #0d0d12;
  rounded: 36px;
  border: 3px solid #1e1e28;
  shadow:
    0 0 0 1px rgba(0,0,0,0.4),
    0 25px 50px -12px rgba(0,0,0,0.55),
    0 0 80px rgba(94, 234, 212, 0.06);
  ov: hidden;
  pos: relative;
}

.status-bar {
  display: flex;
  jc: space-between;
  ai: center;
  pt: 14px;
  px: 22px;
  pb: 8px;
  fs: 13px;
  fw: 600;
  color: var(--st-text);
  ls: 0.02em;
}
.status-icons {
  display: flex;
  gap: 5px;
  fs: 11px;
  op: 0.9;
}

/* ════════════ LEFT — Home ════════════ */
.home-header {
  display: flex;
  ai: center;
  jc: space-between;
  pt: 4px;
  px: 20px;
  pb: 12px;
}
.home-header .logo {
  fs: 17px;
  fw: 700;
  ls: -0.02em;
  color: var(--st-text);
}
.home-header .logo span { color: #818cf8; }

.icon-btn {
  size: 32px;
  rounded: 10px;
  bg: rgba(255,255,255,0.06);
  center: both;
  color: var(--st-muted);
}
.icon-btn .icon {
  @icon-size(16px)
  @icon-color($st-muted)
}

.balance-label {
  px: 22px;
  fs: 13px;
  color: var(--st-muted);
  mb: 4px;
}
.balance-value {
  px: 22px;
  pb: 18px;
  fs: 34px;
  fw: 700;
  ls: -0.03em;
  color: var(--st-text);
}

.cards-row {
  display: flex;
  gap: 12px;
  px: 22px;
  pb: 22px;
  ovx: auto;
  scrollbar-width: none;
}
.cards-row::-webkit-scrollbar { display: none; }

.visa-card {
  flex: 0 0 148px;
  h: 92px;
  rounded: 16px;
  px: 16px;
  py: 14px;
  stack: 0;                 /* column flex; gap 0 — space-between via jc */
  jc: space-between;
  pos: relative;
  ov: hidden;
}
.visa-card.pink {
  bg: linear-gradient(135deg, #f9a8d4 0%, #f472b6 50%, #e879f9 100%);
  color: #1e1b4b;
}
.visa-card.blue {
  bg: linear-gradient(135deg, #7dd3fc 0%, #38bdf8 50%, #818cf8 100%);
  color: #0f172a;
}
.visa-card.orange {
  bg: linear-gradient(135deg, #fdba74 0%, #fb923c 60%, #f97316 100%);
  color: #1c1917;
}
.visa-card .brand {
  fs: 11px;
  fw: 700;
  ls: 0.08em;
  op: 0.85;
}
.visa-card .label {
  fs: 11px;
  op: 0.75;
  mt: 2px;
}
.visa-card .amount {
  fs: 18px;
  fw: 700;
  ls: -0.02em;
}
.visa-card .digits {
  fs: 11px;
  op: 0.7;
  ls: 0.06em;
}

.section-title {
  px: 22px;
  pb: 12px;
  fs: 15px;
  fw: 600;
  color: var(--st-text);
}
.finance-grid {
  cols: 3;
  gap: 10px;
  px: 22px;
  pb: 22px;
}
.finance-item {
  bg: var(--st-card);
  rounded: 16px;
  px: 10px;
  py: 16px;
  ta: center;
  border: 1px solid var(--st-border);
}
.finance-item .icon-wrap {
  size: 36px;
  rounded: 12px;
  mx: auto;
  mb: 8px;
  center: both;
}
.finance-item .icon-wrap.pink { bg: rgba(244, 114, 182, 0.2); }
.finance-item .icon-wrap.cyan { bg: rgba(34, 211, 238, 0.2); }
.finance-item .icon-wrap.orange { bg: rgba(251, 146, 60, 0.2); }
.finance-item .icon-wrap.pink .icon { @icon-color(#f472b6) @icon-size(18px) }
.finance-item .icon-wrap.cyan .icon { @icon-color(#22d3ee) @icon-size(18px) }
.finance-item .icon-wrap.orange .icon { @icon-color(#fb923c) @icon-size(18px) }
.finance-item .name {
  fs: 11px;
  color: var(--st-muted);
  lh: 1.3;
}

.loans-header {
  display: flex;
  jc: space-between;
  ai: center;
  px: 22px;
  pb: 10px;
  fs: 12px;
  color: var(--st-muted);
  tt: uppercase;
  ls: 0.06em;
}
.loan-card {
  mx: 22px;
  mb: 18px;
  bg: var(--st-card);
  rounded: 16px;
  px: 16px;
  py: 14px;
  hstack: 12px;
  ai: center;
  border: 1px solid var(--st-border);
}
.loan-icon {
  size: 36px;
  rounded: 10px;
  bg: rgba(52, 211, 153, 0.15);
  center: both;
  shrink: 0;
}
.loan-icon .icon {
  @icon-color($st-green)
  @icon-size(18px)
}
.loan-info { flex: 1; min-w: 0; }
.loan-info .title {
  fs: 13px;
  fw: 600;
  color: var(--st-text);
}
.loan-info .sub {
  fs: 11px;
  color: var(--st-muted);
  mt: 2px;
}
.loan-right { ta: right; }
.loan-right .amt {
  fs: 14px;
  fw: 600;
  color: var(--st-text);
}
.loan-right .rate {
  fs: 11px;
  color: var(--st-muted);
}

.bottom-nav {
  display: flex;
  jc: space-around;
  ai: center;
  px: 12px;
  pt: 12px;
  pb: 22px;
  bg: linear-gradient(to top, #0d0d12 80%, transparent);
  border-t: 1px solid var(--st-border);
}
.nav-item {
  stack: 4px;
  ai: center;
  fs: 10px;
  color: var(--st-muted);
}
.nav-item .icon {
  @icon-size(20px)
  @icon-color($st-muted)
}
.nav-item.active { color: var(--st-text); }
.nav-item.active .icon { @icon-color($st-text) }
.nav-fab {
  size: 48px;
  rounded: 50%;
  bg: linear-gradient(135deg, #22d3ee, #818cf8);
  center: both;
  color: #0f172a;
  fs: 22px;
  fw: 600;
  shadow: 0 4px 16px rgba(34, 211, 238, 0.35);
  mt: -18px;
}

/* ════════════ RIGHT — Budget ════════════ */
.budget-header {
  display: flex;
  ai: center;
  jc: space-between;
  pt: 4px;
  px: 18px;
  pb: 8px;
}
.budget-header .title {
  fs: 17px;
  fw: 600;
  color: var(--st-text);
}
.budget-header .icon-btn .icon {
  @icon-size(16px)
  @icon-color($st-muted)
}

.budget-amount {
  pt: 4px;
  px: 22px;
  pb: 2px;
  fs: 32px;
  fw: 700;
  ls: -0.03em;
  color: var(--st-text);
}
.budget-meta {
  px: 22px;
  pb: 16px;
  display: flex;
  jc: space-between;
  fs: 12px;
  color: var(--st-muted);
}
.budget-meta .forecast { color: #5eead4; }

@arr budgetData[42, 58, 35, 72, 48, 68, 55]

@st-chart-fill(.chart-fill, budgetData)
@st-chart-line(.chart-line, budgetData)
@st-chart-grid(.chart-grid, 5, 7)
@st-chart-axis-x(.x-axis)

.chart-wrap {
  mx: 18px;
  mb: 8px;
  h: 160px;
  pos: relative;
  rounded: 16px;
  ov: hidden;
  bg: transparent;
}
.chart {
  %2(width, height[: 100%;])
  pos: relative;
  @st-chart-points(budgetData)
}
.chart-fill {
  --st-accent: #5eead4;
  op: 0.25;
}
.chart-line {
  --st-accent: #5eead4;
  @st-chart-line-width(2.5px);
}
.chart-grid { op: 0.25; }

.chart-dot {
  pos: absolute;
  size: 12px;
  rounded: 50%;
  bg: #5eead4;
  border: 3px solid #0d0d12;
  shadow: 0 0 0 2px #5eead4;
  left: 50%;
  top: 25%;
  tf: translate(-50%, -50%);
  z: 5;
}
.chart-tooltip {
  pos: absolute;
  left: 50%;
  top: 2%;
  tf: translateX(-50%);
  bg: #1e293b;
  color: #e2e8f0;
  fs: 11px;
  fw: 600;
  py: 5px;
  px: 10px;
  rounded: 8px;
  ws: nowrap;
  z: 6;
  shadow: 0 4px 12px rgba(0,0,0,0.4);
}
.chart-tooltip::after {
  content: '';
  pos: absolute;
  bottom: -5px;
  left: 50%;
  tf: translateX(-50%);
  border: 5px solid transparent;
  border-t: 5px solid #1e293b;   /* if border-t full form fails, use border-top-color */
}
.chart-tooltip small {
  display: block;
  fs: 9px;
  fw: 500;
  color: #94a3b8;
  mt: 1px;
}

.x-axis {
  display: flex;
  jc: space-between;
  pt: 6px;
  px: 22px;
  pb: 14px;
  fs: 11px;
  color: var(--st-muted);
}

.tx-list {
  mx: 16px;
  mb: 20px;
  bg: var(--st-card);
  rounded: 18px;
  py: 6px;
  border: 1px solid var(--st-border);
}
.tx-date {
  pt: 10px;
  px: 16px;
  pb: 6px;
  fs: 11px;
  color: var(--st-muted);
}
.tx-item {
  hstack: 12px;
  ai: center;
  py: 11px;
  px: 16px;
}
.tx-icon {
  size: 38px;
  rounded: 12px;
  center: both;
  fs: 15px;
  fw: 700;
  shrink: 0;
}
.tx-icon.seo { bg: #1e3a5f; color: #60a5fa; }
.tx-icon.open { bg: #3f1a1a; color: #f87171; }
.tx-icon.spotify { bg: #14352a; color: #34d399; }
.tx-info { flex: 1; min-w: 0; }
.tx-info .name {
  fs: 13.5px;
  fw: 600;
  color: var(--st-text);
}
.tx-info .desc {
  fs: 11px;
  color: var(--st-muted);
  mt: 2px;
}
.tx-amount {
  fs: 14px;
  fw: 600;
  color: var(--st-text);
}

.home-indicator {
  w: 120px;
  h: 4px;
  bg: rgba(255,255,255,0.25);
  rounded: 4px;
  mx: auto;
  mb: 10px;
}
